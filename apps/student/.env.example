# apps/student/.env  (copy file này thành .env rồi điền giá trị thật)
# Dùng NUXT_SESSION_PASSWORD KHÁC với app staff để cookie của 2 site không dùng lẫn được.
NUXT_SESSION_PASSWORD=
NUXT_SUPABASE_URL=
NUXT_SUPABASE_SERVICE_ROLE_KEY=
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Upload tài liệu của sinh viên (Google Drive)
# Nội dung file key JSON của service account (dán nguyên, một dòng)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Thư mục gốc tài liệu sinh viên KHÔNG khai ở đây: khai StudentDoc theo từng domain trong packages/core/config/domains.js
# (tuỳ chọn) tên Edge Function tạo folder, mặc định: create-student-folder
STUDENT_FOLDER_FUNCTION=
